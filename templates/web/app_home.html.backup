    <!-- Quick Action Buttons -->
    <div class="flex justify-between items-center">
        <div class="flex gap-2">
            {% if not facebook_accounts %}
                <button onclick="showFacebookSetup()" class="cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-[color,box-shadow] disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-9 px-4 py-2" data-slot="button">
                    {% translate "Connect Facebook Account" %}
                </button>
            {% else %}
                <button onclick="syncFacebookAds()" class="cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-[color,box-shadow] disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2" data-slot="button" id="sync-ads-btn">
                    {% translate "Sync Campaigns" %}
                </button>
                <a href="{% url 'facebook_ads:campaign_selection' %}" class="cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-[color,box-shadow] disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2" data-slot="button">
                    <i class="fa fa-bullhorn mr-1"></i>
                    {% translate "Manage Campaigns" %}
                </a>
            {% endif %}
        </div>
    </div>
</div>

<!-- Include ShadCN styles and JavaScript functionality -->
{{ facebook_accounts|json_script:'facebook-accounts' }}
{{ show_facebook_setup_modal|json_script:'show-facebook-setup-modal' }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-show Facebook setup modal if no accounts are connected
    const showSetupModal = JSON.parse(document.getElementById('show-facebook-setup-modal').textContent);
    if (showSetupModal) {
        setTimeout(() => {
            showFacebookSetup();
        }, 1000);
    }
    
    // Add interactivity to filter badges
    const filterBadges = document.querySelectorAll('[data-slot="badge"]');
    filterBadges.forEach(badge => {
        badge.addEventListener('click', function() {
            // Toggle active state
            this.classList.toggle('ring-2');
            this.classList.toggle('ring-blue-500');
        });
    });
});

function showFacebookSetup() {
    resetModal();
    document.getElementById('facebook-setup-modal').showModal();
}

function syncFacebookAds() {
    const btn = document.getElementById('sync-ads-btn');
    if (!btn) return;
    
    const originalText = btn.textContent;
    btn.textContent = 'Syncing...';
    btn.disabled = true;

    const facebookAccounts = JSON.parse(document.getElementById('facebook-accounts').textContent);
    const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value || '';
    
    if (facebookAccounts && facebookAccounts.length > 0) {
        const accountId = facebookAccounts[0].id;
        
        fetch(`/facebook-ads/accounts/${accountId}/sync/`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': csrfToken,
                'Content-Type': 'application/json',
            },
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(`Successfully synced ${data.synced_count} campaigns!`);
                location.reload();
            } else {
                alert(`Error: ${data.message}`);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while syncing campaigns.');
        })
        .finally(() => {
            btn.textContent = originalText;
            btn.disabled = false;
        });
    } else {
        alert('No Facebook accounts found.');
        btn.textContent = originalText;
        btn.disabled = false;
    }
}
</script>

<!-- Facebook Setup Modal -->
<dialog id="facebook-setup-modal" class="modal">
  <div class="modal-box w-11/12 max-w-2xl">
    <!-- Hidden form for CSRF token -->
    <form style="display: none;">
      {% csrf_token %}
    </form>
    
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    
    <h3 class="font-bold text-lg mb-4">Facebook Ad Account Toevoegen</h3>
    
    <!-- Step 1: App ID Input -->
    <div id="step-app-id" class="step-content">
      <div class="mb-4">
        <label class="label">
          <span class="label-text">Facebook App ID</span>
        </label>
        <input type="text" id="facebook-app-id" class="input input-bordered w-full" placeholder="Voer uw Facebook App ID in">
        <div class="label">
          <span class="label-text-alt">U vindt dit in uw Facebook Developer Console</span>
        </div>
      </div>
      <div class="modal-action">
        <button onclick="proceedToTokenStep()" class="btn btn-primary">Volgende</button>
        <button onclick="closeModal()" class="btn">Annuleren</button>
      </div>
    </div>
    
    <!-- Step 2: Token Generation -->
    <div id="step-token" class="step-content hidden">
      <div class="mb-4">
        <p class="mb-3">Volg deze stappen om uw access token te genereren:</p>
        <ol class="list-decimal list-inside space-y-2 mb-4">
          <li>Klik op onderstaande link om Facebook Graph API Explorer te openen</li>
          <li>Selecteer uw app en genereer een access token</li>
          <li>Kopieer de token en plak deze in het veld hieronder</li>
        </ol>
        <a id="graph-explorer-link" href="#" target="_blank" class="btn btn-outline mb-4">
          <i class="fa fa-external-link"></i>
          Open Graph API Explorer
        </a>
        
        <label class="label">
          <span class="label-text">Access Token</span>
        </label>
        <textarea id="facebook-token" class="textarea textarea-bordered w-full h-20" placeholder="Plak uw access token hier"></textarea>
      </div>
      <div class="modal-action">
        <button onclick="fetchAdAccounts()" class="btn btn-primary" id="fetch-accounts-btn">Haal Ad Accounts Op</button>
        <button onclick="backToAppIdStep()" class="btn btn-ghost">Terug</button>
      </div>
    </div>
    
    <!-- Step 3: Account Selection -->
    <div id="step-accounts" class="step-content hidden">
      <div class="mb-4">
        <h4 class="font-semibold mb-3">Selecteer Ad Account</h4>
        <div id="ad-accounts-list" class="space-y-2 max-h-60 overflow-y-auto">
          <!-- Ad accounts will be populated here -->
        </div>
      </div>
      <div class="modal-action">
        <button onclick="connectSelectedAccount()" class="btn btn-primary" id="connect-account-btn" disabled>Account Koppelen</button>
        <button onclick="backToTokenStep()" class="btn btn-ghost">Terug</button>
      </div>
    </div>
    
    <!-- Loading state -->
    <div id="loading-state" class="step-content hidden text-center py-8">
      <span class="loading loading-spinner loading-lg"></span>
      <p class="mt-4">Bezig met laden...</p>
    </div>
    
    <!-- Success state -->
    <div id="success-state" class="step-content hidden text-center py-8">
      <div class="text-green-500 text-4xl mb-4">
        <i class="fas fa-check-circle"></i>
      </div>
      <h4 class="font-semibold text-lg mb-2">Account Succesvol Gekoppeld!</h4>
      <p class="text-gray-600 mb-4">Uw Facebook Ad Account is succesvol gekoppeld.</p>
      <button onclick="location.reload()" class="btn btn-primary">Dashboard Herladen</button>
    </div>
    
    <!-- Error state -->
    <div id="error-state" class="step-content hidden text-center py-8">
      <div class="text-red-500 text-4xl mb-4">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <h4 class="font-semibold text-lg mb-2">Er is een fout opgetreden</h4>
      <p class="text-gray-600 mb-4" id="error-message">Er is een probleem opgetreden bij het koppelen van uw account.</p>
      <div class="space-x-2">
        <button onclick="resetModal()" class="btn btn-ghost">Opnieuw Proberen</button>
        <button onclick="closeModal()" class="btn">Sluiten</button>
      </div>
    </div>
  </div>
</dialog>

<script src="{% static 'facebook_ads/js/facebook_setup.js' %}"></script>
{% endblock %}
