{% extends "web/app/app_base.html" %}
{% load i18n %}
{% load static %}
{% load django_vite %}

{% block app %}
<div class="space-y-6">
    <!-- Campaign Header Card -->
    <div class="bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm" data-slot="card">
        <div class="flex flex-col gap-1.5 px-6" data-slot="card-header">
            <div class="flex justify-between items-center">
                <div>
                    <div class="flex items-center gap-2 text-sm text-muted-foreground mb-2">
                        <span>Campaign Name</span>
                        <i class="fa fa-chevron-right text-xs"></i>
                        <span>Campaign Name</span>
                        <span class="ml-auto text-xs">Updated 2m ago</span>
                        <div class="flex items-center gap-1 ml-2">
                            <i class="fa fa-camera text-muted-foreground"></i>
                            <i class="fa fa-clock text-muted-foreground"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Campaign Metrics Cards -->
        <div class="px-6" data-slot="card-content">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                <!-- Total Spend Card -->
                <div class="bg-card text-card-foreground flex flex-col gap-4 rounded-xl border p-4 shadow-sm" data-slot="card">
                    <div class="flex flex-col gap-1">
                        <div class="text-sm text-muted-foreground">Total Spend</div>
                        <div class="text-2xl font-bold">48 h</div>
                        <div class="h-2 bg-gray-200 rounded-full mt-2">
                            <div class="h-2 bg-blue-500 rounded-full w-3/4"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Avg CPC Card -->
                <div class="bg-card text-card-foreground flex flex-col gap-4 rounded-xl border p-4 shadow-sm" data-slot="card">
                    <div class="flex flex-col gap-1">
                        <div class="text-sm text-muted-foreground">Avg CPC</div>
                        <div class="flex items-center gap-2">
                            <svg class="w-12 h-6" viewBox="0 0 48 24">
                                <path d="M2 12 L8 8 L14 16 L20 6 L26 14 L32 4 L38 10 L44 2" stroke="#6366f1" stroke-width="2" fill="none"/>
                            </svg>
                        </div>
                    </div>
                </div>
                
                <!-- ATC Card -->
                <div class="bg-card text-card-foreground flex flex-col gap-4 rounded-xl border p-4 shadow-sm" data-slot="card">
                    <div class="flex flex-col gap-1">
                        <div class="text-sm text-muted-foreground">ATC</div>
                        <div class="text-2xl font-bold">0,14</div>
                    </div>
                </div>
                
                <!-- Purchases Card -->
                <div class="bg-card text-card-foreground flex flex-col gap-4 rounded-xl border p-4 shadow-sm" data-slot="card">
                    <div class="flex flex-col gap-1">
                        <div class="text-sm text-muted-foreground">Purchases</div>
                        <div class="text-2xl font-bold">Avg <span class="text-sm font-normal text-muted-foreground">ROAS</span></div>
                        <div class="text-sm text-muted-foreground">(48 h)</div>
                    </div>
                </div>
            </div>
            
            <!-- Alert Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <!-- Campaign X Alert -->
                <div class="border-l-4 border-orange-400 bg-orange-50 p-4 rounded-md" data-slot="alert">
                    <div class="flex items-center gap-2">
                        <i class="fa fa-exclamation-triangle text-orange-600"></i>
                        <div>
                            <div class="font-medium text-orange-800">Campaign X underperforming</div>
                            <div class="text-sm text-orange-700">ROAS × threshold</div>
                        </div>
                    </div>
                </div>
                
                <!-- Budget Alert -->
                <div class="border-l-4 border-yellow-400 bg-yellow-50 p-4 rounded-md" data-slot="alert">
                    <div class="flex items-center gap-2">
                        <i class="fa fa-exclamation-circle text-yellow-600"></i>
                        <div>
                            <div class="font-medium text-yellow-800">Budget exhausted</div>
                            <div class="text-sm text-yellow-700">current spend</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Campaign Filter Tabs -->
    <div class="bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm" data-slot="card">
        <div class="px-6" data-slot="card-content">
            <!-- Filter Buttons -->
            <div class="flex flex-wrap gap-2 mb-4">
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-green-100 text-green-800" data-slot="badge">
                    Learning
                </button>
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-gray-100 text-gray-800" data-slot="badge">
                    Lemming
                </button>
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-blue-100 text-blue-800" data-slot="badge">
                    Running
                </button>
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-purple-100 text-purple-800" data-slot="badge">
                    High-Perf
                </button>
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-orange-100 text-orange-800" data-slot="badge">
                    Scaling
                </button>
                <button class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-red-100 text-red-800" data-slot="badge">
                    Under-Perf
                </button>
            </div>
            
            <!-- Search and Sort Controls -->
            <div class="flex justify-between items-center mb-4">
                <div class="flex items-center gap-4">
                    <span class="text-sm text-muted-foreground">Columns</span>
                    <span class="text-sm text-muted-foreground">Sort</span>
                    <div class="relative">
                        <input type="text" placeholder="Search" class="pl-8 pr-4 py-2 border border-input rounded-md text-sm">
                        <i class="fa fa-search absolute left-2 top-1/2 transform -translate-y-1/2 text-muted-foreground"></i>
                    </div>
                </div>
                <button class="cursor-pointer inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-[color,box-shadow] disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2" data-slot="button">
                    <i class="fa fa-sort"></i>
                    Sort
                </button>
            </div>
        </div>
    </div>

    <!-- Campaigns Table -->
