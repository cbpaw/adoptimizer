  "item": [
    {
      "name": "🔐 Authentication",
      "description": "Authentication endpoints for login, registration, and user management using Allauth Headless API",
      "item": [
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Get CSRF token from the main page"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract CSRF token from cookies",
                  "const csrfCookie = pm.cookies.get('csrftoken');",
                  "if (csrfCookie) {",
                  "    pm.environment.set('csrfToken', csrfCookie);",
                  "    console.log('CSRF token set:', csrfCookie);",
                  "} else {",
                  "    console.log('No CSRF token found in cookies');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Auth Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              },
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}",
                "description": "Session token if available"
              }
            ],
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/session",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "session"]
            },
            "description": "Get current authentication status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract and set session token if present",
                  "if (pm.response.json().meta && pm.response.json().meta.session_token) {",
                  "    pm.environment.set('sessionToken', pm.response.json().meta.session_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              },
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}",
                "description": "Session token if available"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/login",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "User login endpoint using Allauth Headless API"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract and set session token from response",
                  "if (pm.response.json().meta && pm.response.json().meta.session_token) {",
                  "    pm.environment.set('sessionToken', pm.response.json().meta.session_token);",
                  "    console.log('Session token set:', pm.response.json().meta.session_token);",
                  "}",
                  "",
                  "// Test successful login",
                  "pm.test('Login successful', function () {",
                  "    pm.expect(pm.response.json().status).to.equal(200);",
                  "    pm.expect(pm.response.json().meta.is_authenticated).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              },
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}",
                "description": "Session token if available"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new_user@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/signup",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "User registration endpoint using Allauth Headless API"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract and set session token from response",
                  "if (pm.response.json().meta && pm.response.json().meta.session_token) {",
                  "    pm.environment.set('sessionToken', pm.response.json().meta.session_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              },
              {
                "key": "X-Session-Token",
                "value": "{{sessionToken}}",
                "description": "Session token required for logout"
              }
            ],
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/session",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "session"]
            },
            "description": "User logout endpoint using Allauth Headless API"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Clear session token on logout",
                  "pm.environment.set('sessionToken', '');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/password/request",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "password", "request"]
            },
            "description": "Request password reset using Allauth Headless API"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}",
                "description": "CSRF token for authentication"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"reset_code_from_email\",\n  \"password\": \"new_password_123\"\n}"
            },
            "url": {
              "raw": "{{allauthBaseUrl}}/auth/password/reset",
              "host": ["{{allauthBaseUrl}}"],
              "path": ["auth", "password", "reset"]
            },
            "description": "Reset password with code using Allauth Headless API"
          }
        }
      ]
    },
